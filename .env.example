# Copy to .env and fill in. Never commit .env.
#
# openai | azure | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OpenRouter: set LLM_PROVIDER=openrouter or use an sk-or- key (auto-detected)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional override, e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=
# Azure only
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Playwright
PLAYWRIGHT_HEADLESS=true

# Microsoft Graph / Teams API (required to actually send chats)
# Create an Entra ID App registration: public client, redirect http://localhost,
# Allow public client flows, delegated permissions:
# Chat.ReadWrite, ChatMessage.Send, People.Read, User.Read, offline_access
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=organizations

